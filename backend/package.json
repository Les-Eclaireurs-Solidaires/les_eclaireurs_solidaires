{
  "name": "les_eclaireurs_solidaires_backend",
  "version": "1.0.0",
  "description": "Backend for Les Éclaireurs Solidaires",
  "main": "src/index.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "cross-env CHOKIDAR_USEPOLLING=true tsx watch --clearScreen=false src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest run --watch"
  },
  "keywords": [
    "les",
    "eclaireurs",
    "solidaires",
    "backend",
    "node",
    "express"
  ],
  "type": "module",
  "dependencies": {
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "mysql2": "^3.18.0"
  },
  "devDependencies": {
    "@types/argon2": "^0.14.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.3.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
