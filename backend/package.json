{
  "name": "les_eclaireurs_solidaires_backend",
  "version": "1.0.0",
  "description": "Backend for Les Éclaireurs Solidaires",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "cross-env CHOKIDAR_USEPOLLING=true tsx watch --clearScreen=false src/index.ts",
    "test": "vitest run --mode test",
    "test:watch": "vitest --watch --mode test",
    "test:docker": "vitest run --mode test.docker"
  },
  "keywords": [
    "les",
    "eclaireurs",
    "solidaires",
    "backend",
    "node",
    "express"
  ],
  "type": "module",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ms": "^2.1.3",
    "mysql2": "^3.18.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.3.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
